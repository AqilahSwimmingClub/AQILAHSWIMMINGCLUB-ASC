{
  "name": "aqilah-swimming-club",
  "private": true,
  "version": "3.0.1-mobile-export-fix",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "android:add": "npx cap add android",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:setup": "npm run build && npx cap add android && node scripts/set-android-min-sdk.cjs && npx cap sync android",
    "android:update": "npm run build && node scripts/set-android-min-sdk.cjs && npx cap sync android",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:tata-letak": "node --test tests/tata-letak.test.js",
    "test:unit": "node --test tests/penghapusan-permanen.test.js tests/nisan-sinkron.test.js tests/browser-portabel.test.js",
    "test:e2e": "node --test tests/e2e-responsif.test.js"
  },
  "dependencies": {
    "@capacitor/core": "^7.4.3",
    "@supabase/supabase-js": "^2.52.1",
    "jspdf": "^3.0.2",
    "jspdf-autotable": "^5.0.2",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/cli": "^7.4.3",
    "playwright": "^1.63.0",
    "supabase": "^2.111.0",
    "vite": "^5.4.0"
  }
}
