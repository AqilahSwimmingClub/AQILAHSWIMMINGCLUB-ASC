# Salin file ini menjadi android/keystore.properties lalu isi sesuai keystore Anda.
# JANGAN pernah commit android/keystore.properties ke git: isinya kata sandi.
#
# storeFile ditulis relatif terhadap folder android/.
# Contoh: asc-release.jks berarti android/asc-release.jks
storeFile=asc-release.jks
storePassword=ISI_KATA_SANDI_KEYSTORE
keyAlias=asc
keyPassword=ISI_KATA_SANDI_KUNCI
