# Salin file ini menjadi android/keystore.properties lalu isi kata sandinya.
# JANGAN pernah commit android/keystore.properties ke git: isinya kata sandi.
# Berkas itu sudah terdaftar di .gitignore.
#
# storeFile ditulis relatif terhadap folder android/.
# Contoh: asc-release.p12 berarti android/asc-release.p12
#
# Keystore ASC memakai format PKCS12, alias asc-release. Kata sandi keystore
# dan kata sandi kunci sama. Isi kedua baris kata sandi di bawah dengan kata
# sandi yang Anda pakai saat membuat keystore.
storeFile=asc-release.p12
storeType=PKCS12
storePassword=ISI_KATA_SANDI_KEYSTORE
keyAlias=asc-release
keyPassword=ISI_KATA_SANDI_KUNCI
